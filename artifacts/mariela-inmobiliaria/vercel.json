{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "env": {
    "VITE_API_URL": "https://inmobiliaria-5s58.onrender.com",
    "VITE_GA_ID": "G-S8BXKFDH0S"
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/propiedades/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_API_URL": "https://inmobiliaria-5s58.onrender.com",
      "VITE_GA_ID": "G-S8BXKFDH0S"
    }
  }
}
